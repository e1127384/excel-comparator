file1: file1.xlsx
file2: file2.xlsx
sheet1: Sheet1
sheet2: Sheet1
# Optional. Empty means use first column only (current behavior).
# keyFields: [caseid, country]
keyFields: []
mappingFile: ""
outputFile: comparison_report.xlsx
caseSensitive: false
strictDate: false
normalizeList: true
compareFields: []
caseQualifier: ""
fieldGroups: []
# caseQualifier filters which records from File 1 are included in the comparison.
# If omitted or empty, all records are considered.
# Supported operators: = != IN NOT IN
# Logical operators:   AND OR  (parentheses supported for grouping)
# Multi-word field names and values are supported.
# Note: for values that contain spaces, use quoted strings (single or double) to
# avoid ambiguity. e.g.  Status = "Not Started"  or  Status = 'Not Started'
# Examples:
#   caseQualifier: "Status != Cancelled"
#   caseQualifier: "Status != Cancelled AND Case Id NOT IN (caseid1, caseid2)"
#   caseQualifier: "(Status = Open OR Status = Pending) AND Priority != Low"
# fieldGroups example:
# fieldGroups:
#   - name: "Geography"
#     fields: [country, sub-region, region]
#   - name: "Classification"
#     fields: [category, sub-category]
